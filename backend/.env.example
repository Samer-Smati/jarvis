# JARVIS Backend Environment (copy to .env)

# Runtime profile: vercel | desktop
JARVIS_RUNTIME=desktop

# Database — Neon Postgres (recommended for cloud + pgvector)
# DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require

# Local SQLite fallback
DATABASE_PATH=data/jarvis.sqlite

# LLM provider: gemini | groq | ollama | lmstudio | claude | openrouter | xai | cloudflare
# Recommended free stack (matches Groq → Gemini → OpenRouter failover):
#   LLM_PROVIDER=groq
#   GEMINI_API_KEY=...   (multimodal + tool-heavy tasks)
#   GROQ_API_KEY=...     (fast chat + optional cloud STT)
#   OPENROUTER_API_KEY=... (last-resort fallback)
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Embeddings
EMBED_PROVIDER=gemini

# Vercel Blob (brain vault + conversations when no DATABASE_URL)
BLOB_READ_WRITE_TOKEN=

# GitHub self-improve
GITHUB_TOKEN=
GITHUB_REPO=Samer-Smati/jarvis

# Skill tier cap: read | write | network | sandbox (enforced at API level)
JARVIS_MAX_SKILL_TIER=sandbox

# Web search (Tavily — free tier: 1,000 searches/month, no credit card; sign up at https://tavily.com)
TAVILY_API_KEY=

# Cloudflare Workers AI — last-resort free LLM fallback: 10,000 Neurons/day, no credit card,
# resets daily. Sign up free at https://dash.cloudflare.com. CLOUDFLARE_ACCOUNT_ID is on the
# dashboard overview page. Both must be set for this fallback to activate.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Voice (desktop) — set JARVIS_CLOUD_STT=1 to use Groq Whisper when GROQ_API_KEY is set
JARVIS_WAKE_WORD=0
PORCUPINE_ACCESS_KEY=
JARVIS_CLOUD_STT=0

# Smart home (optional)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Email (optional)
SMTP_HOST=
CRYPTO_ALERT_EMAIL=

# Data paths
DATA_ROOT=data
JARVIS_LLM_ENSURE=probe

# Experiential memory (lessons)
JARVIS_LESSONS_TOP_N=3
JARVIS_LESSONS_MIN_CONFIDENCE=0.55
JARVIS_LESSONS_MERGE_THRESHOLD=0.85
JARVIS_LESSONS_STALE_DAYS=30
JARVIS_LESSONS_EXTRACTION_MODEL=

# Vercel (set in Project → Settings → Environment Variables)
# VERCEL=1
# JARVIS_SERVERLESS=1
# JARVIS_LLM_ENSURE=off
# DATABASE_URL=postgresql://...
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# BLOB_READ_WRITE_TOKEN=
# TAVILY_API_KEY=  (search + Extract fallback for brain ingest_url on JS-heavy pages)
# CLOUDFLARE_API_TOKEN=  (last-resort free LLM fallback; needs CLOUDFLARE_ACCOUNT_ID too)
# CLOUDFLARE_ACCOUNT_ID=
# JARVIS_FETCH_MAX_BYTES=512000  (raw HTML read cap; extracted text capped at 32k chars)
# JARVIS_LESSONS_TOP_N=3
# JARVIS_LESSONS_MIN_CONFIDENCE=0.55
# JARVIS_LESSONS_MERGE_THRESHOLD=0.85
