{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [{ "include": "llm/llm-routing.config.json", "outDir": "dist" }]
  },
  "watchOptions": {
    "ignored": ["data/**", "**/whisper-cache/**", "**/.cache/**"]
  }
}
